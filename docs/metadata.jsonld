    "injury severity (binary)",
    "weather condition",
    "lighting condition",
    "roadway surface condition",
    "road defect",
    "posted speed limit",
    "traffic control device",
    "primary contributory cause",
    "crash hour, day, month",
    "latitude and longitude",
    "mean age of people involved",
    "number of people involved",
    "any alcohol use indicator"
  ],
  "measurementTechnique": "Aggregation of person-level records to crash level via crash_record_id, followed by a left join with the Crashes table. Logistic regression with class-weight balancing fit on one-hot encoded categorical features and standard-scaled numerical features.",
